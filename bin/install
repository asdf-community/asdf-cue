#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=lib/utils.bash
source "$(dirname "$0")/../lib/utils.bash"

install_cue() {
  local install_type=$1
  local version=$2
  local install_path=$3

  if [ "$install_type" != "version" ]; then
    fail "asdf-cue supports release installs only"
  fi

  local release_url archive_path resolved_version
  resolved_version=$(resolve_version "$version")
  platform=$(get_platform)
  arch=$(get_arch)
  ext="$(archive_extension "$platform")"

  local source_path=""
  local destination="${install_path}/bin"
  if [ -n "${ASDF_DOWNLOAD_PATH:-}" ]; then
    source_path="${ASDF_DOWNLOAD_PATH}/cue.${ext}"
  fi

  (
    echo "∗ Installing cue $resolved_version..."
    mkdir -p "$destination"
    if [ -z "$source_path" ] || [ ! -f "$source_path" ]; then
      archive_path="${install_path}/bin/cue.${ext}"
      release_url=$(download_url "$resolved_version" "$platform" "$arch" "$ext")
      curl "${curl_opts[@]}" -o "$archive_path" "$release_url" || fail "Could not download $release_url"
      source_path="$archive_path"
    fi
    case $platform in
      windows)
        unzip "$source_path" -d "$destination" || fail "Could not uncompress"
        ;;
      *)
        tar zxvf "$source_path" -C "$destination" >/dev/null || fail "Could not uncompress"
        ;;
    esac

    rm -f "$source_path"
    echo "The cue $resolved_version installation was successful!"
  ) || (
    rm -rf "$install_path"
    fail "An error occurred"
  )
}

install_cue "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH"
